# ==============================================================================
# MediGo Production & Development Environment Configuration
# German Medical Courier Logistics (UN 3373 ADR & GDPR Art. 9 Compliant)
# ==============================================================================

# Application Base URL (Required for CSRF origin validation and absolute links)
# In production, must be the canonical HTTPS domain (e.g., https://app.medigo.de)
APP_URL="http://localhost:3000"

# Comma-separated list of allowed origins for CORS and CSRF validation
# Must match trusted frontend origins. Never use wildcards in production.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Node Environment: 'development', 'production', or 'test'
# Setting to 'production' enforces secure cookie flags and disables debug endpoints.
NODE_ENV="development"

# PostgreSQL Direct Connection String (Used by Prisma ORM / Migration Engine)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres_secure_password@db.xyzcompany.supabase.co:5432/postgres?schema=public"

# Supabase Project HTTPS Endpoint URL
SUPABASE_URL="https://xyzcompany.supabase.co"

# Supabase Secret Service Role Key (Used for server-side elevated database operations)
# CRITICAL: Never expose this key to browser client bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key"

# Supabase Public Anonymous API Key
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key"

# JSON Web Token Secret Key (HS256)
# MANDATORY: Minimum 32 characters (server will refuse to start if missing or < 32 chars).
# Generate cryptographically secure secret: openssl rand -base64 48
JWT_SECRET="replace_with_at_least_32_character_cryptographically_secure_random_secret_phrase_2026"

# Automated Database Seeding Flag (Set to 'true' or 'false')
# When true, initializes default accounts (forced password change required upon login).
SEED_ON_START="false"

# Optional: Vercel System Deployment URL (automatically injected by Vercel platform)
# VERCEL_URL="medigo-deployment-id.vercel.app"

# Optional: Vercel Production Custom Domain URL (automatically injected by Vercel platform)
# VERCEL_PROJECT_PRODUCTION_URL="app.medigo.de"

# Google Gemini API Key (Optional AI features)
GEMINI_API_KEY=""
